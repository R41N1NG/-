{
  "name": "weixing-engine",
  "version": "0.8.24",
  "private": true,
  "description": "尾行 · 数值引擎与酒馆角色卡（检定/心跳/警觉/冲突/追逐/HUD）",
  "scripts": {
    "test": "node tools/test.cjs",
    "build": "node build.js",
    "build:runtime": "node build-runtime.js",
    "build:ui": "node tools/build/ui.js",
    "format:modules": "prettier --write \"src/runtime/game/**/*.js\" \"src/host/**/*.js\" \"src/ui/**/*.js\" build*.js \"tools/build/*.js\" tools/test.cjs",
    "test:sync": "node tools/test.cjs investigation.test.js chat-sync.test.js timeline.test.js day-plan.test.js daily-actions.test.js economy.test.js spatial.test.js sync-notice.test.js m4.test.js inject.test.js target-default.test.js album.test.js resource-sweet.test.js route-notes.test.js",
    "typecheck": "tsc -p tsconfig.contracts.json",
    "test:browser": "node tools/check-browser.cjs",
    "preview:pi": "node tools/build/pi-preview.js",
    "preview:daily": "node tools/build/day-preview.js",
    "screenshots:training": "node tools/build/training-shots.js",
    "preview:training": "node tools/build/training-preview.js",
    "preview:attributes": "node tools/build/training-preview.js --attributes",
    "screenshots:day-tutorial": "node tools/build/day-tailing-shots.js",
    "preview:day-tutorial": "node tools/build/day-tailing-preview.js",
    "test:day-tutorial": "node tools/check-day-tailing-course.cjs",
    "screenshots:heart-tutorial": "node tools/build/heart-lesson-shots.js",
    "preview:heart-tutorial": "node tools/build/heart-lesson-preview.js",
    "test:heart-tutorial": "node tools/check-heart-lesson.cjs",
    "screenshots:stamina-tutorial": "node tools/build/stamina-lesson-shots.js",
    "preview:stamina-tutorial": "node tools/build/stamina-lesson-preview.js",
    "test:stamina-tutorial": "node tools/check-stamina-lesson.cjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
