[
  {
    "id": "zyx-hud-ink-v1",
    "scriptName": "ZYX_02_状态栏HUD渲染",
    "findRegex": "<status_bar>\\s*(?:<time>(?<time>[^<]*)</time>\\s*)?(?:<elapsed>(?<elapsed>[^<]*)</elapsed>\\s*)?(?:<location>(?<location>[^<]*)</location>\\s*)?(?:<weather>(?<weather>[^<]*)</weather>\\s*)?(?:<environment>(?<environment>[^<]*)</environment>\\s*)?(?:<favor_char>(?<favor_char>[^<]*)</favor_char>\\s*)?(?:<favor_stage>(?<favor_stage>[^<]*)</favor_stage>\\s*)?(?:<favor_aura>(?<favor_aura>[^<]*)</favor_aura>\\s*)?(?:<favor_reason>(?<favor_reason>[^<]*)</favor_reason>\\s*)?(?:<favor_mind>(?<favor_mind>[^<]*)</favor_mind>\\s*)?(?:<favor_companion>(?<favor_companion>[^<]*)</favor_companion>\\s*)?(?:<extra_char_1>(?:\\s*<name>(?:无|暂无|无他人|暂无他人|独处)</name>\\s*(?:<stage>[^<]*</stage>\\s*)?(?:<aura>[^<]*</aura>\\s*)?(?:<mind>[^<]*</mind>\\s*)?(?:<demeanor>[^<]*</demeanor>\\s*)?|\\s*<name>(?<e1_name>[^<]*)</name>\\s*<stage>(?<e1_stage>[^<]*)</stage>\\s*<aura>(?<e1_aura>[^<]*)</aura>\\s*<mind>(?<e1_mind>[^<]*)</mind>\\s*<demeanor>(?<e1_demeanor>[^<]*)</demeanor>\\s*|[^<]*)</extra_char_1>\\s*)?(?:<extra_char_2>(?:\\s*<name>(?:无|暂无|无他人|暂无他人|独处)</name>\\s*(?:<stage>[^<]*</stage>\\s*)?(?:<aura>[^<]*</aura>\\s*)?(?:<mind>[^<]*</mind>\\s*)?(?:<demeanor>[^<]*</demeanor>\\s*)?|\\s*<name>(?<e2_name>[^<]*)</name>\\s*<stage>(?<e2_stage>[^<]*)</stage>\\s*<aura>(?<e2_aura>[^<]*)</aura>\\s*<mind>(?<e2_mind>[^<]*)</mind>\\s*<demeanor>(?<e2_demeanor>[^<]*)</demeanor>\\s*|[^<]*)</extra_char_2>\\s*)?(?:<growth_skill>(?<growth_skill>[^<]*)</growth_skill>\\s*)?(?:<growth_reason>(?<growth_reason>[^<]*)</growth_reason>\\s*)?(?:<growth_weight>(?<growth_weight>[^<]*)</growth_weight>\\s*)?(?:<roster_event>(?<roster_event>[^<]*)</roster_event>\\s*)?(?:<bailian_state>(?<bailian_state>[^<]*)</bailian_state>\\s*)?(?:<shuangling_state>(?<shuangling_state>[^<]*)</shuangling_state>\\s*)?(?:<clue>(?<clue>[^<]*)</clue>\\s*)?(?:<clue_obtained>(?<clue_obtained>[^<]*)</clue_obtained>\\s*)?(?:<news_near>(?<news_near>[^<]*)</news_near>\\s*)?(?:<news_mid>(?<news_mid>[^<]*)</news_mid>\\s*)?(?:<crisis>(?<crisis>[^<]*)</crisis>\\s*)?</status_bar>",
    "replaceString": "<style>\n.zyx-hud,.zyx-hud * {box-sizing:border-box;}\n.zyx-hud {--zh-text:#e6dfcd;--zh-muted:#aaa997;--zh-gold:#b1a17c;position:relative;isolation:isolate;width:100%;max-width:760px;margin:22px auto;color:var(--zh-text);background:linear-gradient(135deg,#202725,#121c1d 65%,#172224);border:1px solid #8f88734d;border-radius:2px;padding:0 25px 10px;box-shadow:0 12px 30px #0003;font:13px/1.85 ui-serif,'Songti SC',SimSun,serif;text-align:left;overflow-wrap:anywhere;}\n.zyx-hud::before {content:'';position:absolute;inset:6px;border:1px solid #b6a57913;pointer-events:none;z-index:-1;}\n.zyx-hud .zyx-hud-head {display:flex;align-items:center;gap:15px;padding:16px 0 14px;border-bottom:1px solid #ac9f7733;}\n.zyx-hud .zyx-hud-head>span:first-child {font-size:10px;letter-spacing:.16em;color:var(--zh-muted);}\n.zyx-hud .zyx-hud-head b {font-size:16px;font-weight:400;letter-spacing:.2em;margin-left:auto;}\n.zyx-hud .zyx-hud-seal {font-size:12px;line-height:1.3;color:#c47e61;border:1px solid #98533f;padding:3px 4px;transform:rotate(-5deg);}\n.zyx-hud .zyx-hud-top {display:grid;grid-template-columns:minmax(0,1fr) minmax(120px,.38fr);gap:10px 20px;padding-top:18px;}\n.zyx-hud .zyx-hud-top>div {min-width:0;}\n.zyx-hud .zyx-hud-label {display:block;font-size:9px;letter-spacing:.15em;color:var(--zh-gold);margin-bottom:3px;}\n.zyx-hud .zyx-hud-time>.zyx-hud-value {font-size:17px;letter-spacing:.04em;line-height:1.75;}\n.zyx-hud .zyx-hud-place>.zyx-hud-value {font-size:14px;}\n.zyx-hud .zyx-hud-elapsed,.zyx-hud .zyx-hud-weather {border-left:1px solid #a59c752b;padding-left:17px;}\n.zyx-hud .zyx-hud-elapsed>.zyx-hud-value,.zyx-hud .zyx-hud-weather>.zyx-hud-value {font-size:12px;color:#c1c3b3;}\n.zyx-hud .zyx-hud-environment {margin:15px 0 16px;padding-left:10px;border-left:2px solid #857b574d;color:#aeb6a8;font-size:11px;line-height:1.9;}\n.zyx-hud .zyx-hud-value:empty::before {content:'未记';color:#9ca497;}\n.zyx-hud .zyx-hud-ledger {border-top:1px solid #ac9f7740;}\n.zyx-hud .zyx-hud-fold {border-bottom:1px solid #ac9f7728;margin:0;}\n.zyx-hud .zyx-hud-fold:last-child {border-bottom:0;}\n.zyx-hud summary {cursor:pointer;list-style:none;}\n.zyx-hud summary::-webkit-details-marker {display:none;}\n.zyx-hud .zyx-hud-fold>summary {display:flex;gap:13px;align-items:center;min-height:58px;padding:13px 0;transition:color 160ms ease;}\n.zyx-hud .zyx-hud-fold>summary:hover {color:#f4e7ce;}\n.zyx-hud summary:focus-visible {outline:2px solid #b8a67e;outline-offset:3px;}\n.zyx-hud .zyx-hud-index {font-size:10px;color:#a68e64;flex:0 0 14px;}\n.zyx-hud .zyx-hud-title {font-size:14px;letter-spacing:.12em;flex-shrink:0;}\n.zyx-hud .zyx-hud-summary {margin-left:auto;display:flex;align-items:center;flex-wrap:wrap;gap:7px;justify-content:flex-end;color:#abae9c;font-size:11px;min-width:0;text-align:right;}\n.zyx-hud .zyx-hud-summary i {font-style:normal;color:#6b796c;}\n.zyx-hud .zyx-hud-chevron {font:18px/1 system-ui;color:#ac9670;flex:0 0 18px;text-align:center;transition:transform 180ms ease;}\n.zyx-hud .zyx-hud-fold[open]>summary .zyx-hud-chevron {transform:rotate(45deg);}\n.zyx-hud .zyx-hud-fold[open]>summary {color:#ead8b5;}\n.zyx-hud .zyx-hud-body {padding:3px 0 21px 27px;}\n.zyx-hud .zyx-hud-person {display:flex;justify-content:space-between;align-items:center;gap:15px;margin:3px 0 16px;}\n.zyx-hud h3 {font-size:21px;font-weight:400;letter-spacing:.12em;margin:0;}\n.zyx-hud .zyx-hud-aura {color:#b7c1ad;background:#9db18a0c;border:1px solid #a2b18f42;padding:3px 9px;font-size:11px;}\n.zyx-hud dl {display:grid;grid-template-columns:60px minmax(0,1fr);gap:11px 12px;margin:0;}\n.zyx-hud dt {font-size:11px;color:#a89c7d;}\n.zyx-hud dd {margin:0;color:#d3d4c4;white-space:pre-wrap;font-size:12px;line-height:2;}\n.zyx-hud .zyx-hud-key {display:block;color:#8e9e91;font-size:10px;margin-top:5px;}\n.zyx-hud .zyx-hud-note {font-size:10px;color:#9da895;margin:0 0 13px;}\n.zyx-hud dl+.zyx-hud-note {margin:14px 0 0;}\n.zyx-hud .zyx-hud-subfold {border-top:1px solid #a29a7430;margin-top:18px;padding-top:12px;}\n.zyx-hud .zyx-hud-subfold>summary {font-size:11px;color:#b4ac93;}\n.zyx-hud .zyx-hud-extra {margin-top:14px;}\n.zyx-hud h4 {font-weight:400;font-size:11px;letter-spacing:.1em;color:#bbaa83;margin:0 0 7px;}\n.zyx-hud .zyx-hud-extra-fields {font-size:12px;color:#c4cbbb;line-height:2;margin-bottom:14px;}\n.zyx-hud .zyx-hud-extra-fields:empty::before {content:'无';}\n.zyx-hud .zyx-hud-extra-fields>name {display:block;color:#e2d8bf;font-size:14px;}\n.zyx-hud .zyx-hud-extra-fields>stage,.zyx-hud .zyx-hud-extra-fields>aura {display:inline-block;color:#b5bea7;font-size:10px;margin:3px 10px 7px 0;}\n.zyx-hud .zyx-hud-extra-fields>mind,.zyx-hud .zyx-hud-extra-fields>demeanor {display:block;margin:4px 0;}\n.zyx-hud .zyx-hud-extra-fields>mind::before {content:'心声 · ';color:#a39877;font-size:10px;}\n.zyx-hud .zyx-hud-extra-fields>demeanor::before {content:'形貌 · ';color:#a39877;font-size:10px;}\n.zyx-hud .zyx-hud-news h4 {border-left:2px solid #8f8056;padding-left:8px;}\n.zyx-hud .zyx-hud-news p {font-size:12px;color:#c8cbb9;margin:0 0 18px;line-height:2;}\n.zyx-hud .zyx-hud-news p:last-child {margin-bottom:0;}\n@media (max-width:560px) {\n .zyx-hud {padding:0 16px 6px;margin:16px auto;}\n .zyx-hud .zyx-hud-top {grid-template-columns:minmax(0,1fr);gap:11px;}\n .zyx-hud .zyx-hud-time>.zyx-hud-value {font-size:16px;}\n .zyx-hud .zyx-hud-elapsed,.zyx-hud .zyx-hud-weather {padding:0;border-left:0;display:flex;gap:10px;align-items:baseline;}\n .zyx-hud .zyx-hud-elapsed>.zyx-hud-label,.zyx-hud .zyx-hud-weather>.zyx-hud-label {margin:0;flex:0 0 55px;}\n .zyx-hud .zyx-hud-body {padding-left:0;}\n .zyx-hud .zyx-hud-fold>summary {gap:8px;flex-wrap:wrap;}\n .zyx-hud .zyx-hud-summary {max-width:48%;gap:4px;}\n .zyx-hud .zyx-hud-index {flex-basis:10px;}\n .zyx-hud .zyx-hud-title {font-size:13px;letter-spacing:.06em;}\n .zyx-hud .zyx-hud-chevron {flex-basis:14px;margin-left:auto;}\n .zyx-hud .zyx-hud-summary {margin-left:auto;}\n .zyx-hud .zyx-hud-person {gap:8px;}\n .zyx-hud dl {grid-template-columns:52px minmax(0,1fr);gap:9px;}\n}\n@media (prefers-reduced-motion:reduce) {\n .zyx-hud .zyx-hud-fold>summary,.zyx-hud .zyx-hud-chevron {transition:none;}\n}\n\n/* 参考大乾的信息架构：时地四格 → 天下气象 → 在场人物 → 线索与双栏风闻。 */\n.zyx-hud .zyx-hud-top {grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:8px;padding-top:15px;}\n.zyx-hud .zyx-hud-top>div {padding:10px 12px;border:1px solid #b1a17c26;background:#b1a17c04;}\n.zyx-hud .zyx-hud-time>.zyx-hud-value {font-size:14px;}\n.zyx-hud .zyx-hud-place>.zyx-hud-value {font-size:13px;}\n.zyx-hud .zyx-hud-weather>.zyx-hud-value,.zyx-hud .zyx-hud-senses>.zyx-hud-value {font-size:11px;color:#bdc4b2;}\n.zyx-hud .zyx-hud-round {display:flex;flex-wrap:wrap;gap:7px 20px;padding:11px 0;font-size:10px;color:#a89c80;}\n.zyx-hud .zyx-hud-round b {font-weight:400;color:#cbd1bd;margin-left:7px;}\n.zyx-hud .zyx-hud-trend {padding:13px 15px;margin:0 0 6px;background:linear-gradient(100deg,#7c3b2d21,#5537280a);border-left:2px solid #965840;}\n.zyx-hud .zyx-hud-trend h4 {color:#d09572;font-size:10px;}\n.zyx-hud .zyx-hud-trend p {margin:0;font-size:12px;color:#cac2ad;line-height:1.9;}\n.zyx-hud .zyx-hud-bond>.zyx-hud-body {position:relative;padding:8px 0 20px 27px;}\n.zyx-hud .zyx-hud-person {border-bottom:1px solid #a79b7530;padding-bottom:14px;margin-bottom:14px;}\n.zyx-hud .zyx-hud-person h3 {font-size:25px;}\n.zyx-hud .zyx-hud-bond dd {font-size:12px;}\n.zyx-hud .zyx-hud-clue {padding:15px 16px;margin:14px 0 9px;background:#9c9f6410;border:1px solid #b1a17c40;}\n.zyx-hud .zyx-hud-clue h4 {color:#c1b185;}\n.zyx-hud .zyx-hud-clue p {font-size:12px;line-height:2;color:#d2d0b7;margin:0;}\n.zyx-hud .zyx-hud-rumors {display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 0 9px;}\n.zyx-hud .zyx-hud-rumors>section {padding:13px 14px;background:#9cae9406;border:1px solid #9cae942b;min-width:0;}\n.zyx-hud .zyx-hud-rumors h4 {font-size:10px;color:#a5b19e;}\n.zyx-hud .zyx-hud-rumors p {font-size:11px;color:#b1bdac;line-height:2;margin:0;}\n.zyx-hud .zyx-hud-extra-person:has(>h4:empty) {display:none;}\n.zyx-hud .zyx-hud-extra:has(.zyx-hud-extra-person>h4:not(:empty)) .zyx-hud-extra-empty {display:none;}\n.zyx-hud .zyx-hud-extra-empty {font-size:11px;color:#98a48f;}\n.zyx-hud .zyx-hud-extra-stage,.zyx-hud .zyx-hud-extra-aura {color:#b5bea7;font-size:10px;margin-right:12px;}\n.zyx-hud .zyx-hud-extra-fields p {display:flex;gap:10px;font-size:11px;margin:5px 0;}\n.zyx-hud .zyx-hud-extra-fields em {font-style:normal;color:#a39877;flex:0 0 30px;}\n@media(max-width:560px) {\n .zyx-hud .zyx-hud-top {grid-template-columns:minmax(0,1fr);}\n .zyx-hud .zyx-hud-top>div {padding:8px 10px;}\n .zyx-hud .zyx-hud-weather {display:block;}\n .zyx-hud .zyx-hud-bond>.zyx-hud-body {padding-left:0;}\n .zyx-hud .zyx-hud-rumors {grid-template-columns:minmax(0,1fr);}\n}\n\n</style>\n<div class=\"zyx-hud\" role=\"region\" aria-label=\"丹杏行旅手记\">\n  <header class=\"zyx-hud-head\"><span>朱颜血 · 丹杏</span><b>行旅手记</b><span class=\"zyx-hud-seal\">录</span></header>\n  <div class=\"zyx-hud-top\">\n    <div class=\"zyx-hud-time\"><span class=\"zyx-hud-label\">时 令</span><span class=\"zyx-hud-value\">$<time></span></div>\n\n    <div class=\"zyx-hud-place\"><span class=\"zyx-hud-label\">行 至</span><span class=\"zyx-hud-value\">$<location></span></div>\n    <div class=\"zyx-hud-weather\"><span class=\"zyx-hud-label\">天 候</span><span class=\"zyx-hud-value\">$<weather></span></div>\n    <div class=\"zyx-hud-senses\"><span class=\"zyx-hud-label\">四 围</span><span class=\"zyx-hud-value\">$<environment></span></div>\n  </div>\n  <div class=\"zyx-hud-round\"><span>此番历时 <b class=\"zyx-hud-value\">$<elapsed></b></span><span>本轮所习 <b class=\"zyx-hud-value\">$<growth_skill></b></span></div>\n  <section class=\"zyx-hud-trend\"><h4>天下气象</h4><p class=\"zyx-hud-value\">$<crisis></p></section>\n  <div class=\"zyx-hud-ledger\">\n    <details class=\"zyx-hud-fold zyx-hud-bond\" open>\n      <summary><span class=\"zyx-hud-index\">壹</span><span class=\"zyx-hud-title\">羁绊心境</span><span class=\"zyx-hud-summary\"><span class=\"zyx-hud-value\">$<favor_char></span><i>·</i><span class=\"zyx-hud-value\">$<favor_stage></span></span><span class=\"zyx-hud-chevron\" aria-hidden=\"true\">＋</span></summary>\n      <div class=\"zyx-hud-body\">\n        <div class=\"zyx-hud-person\"><h3 class=\"zyx-hud-value\">$<favor_char></h3><span class=\"zyx-hud-aura zyx-hud-value\">$<favor_aura></span></div>\n        <dl><dt>因由</dt><dd class=\"zyx-hud-value\">$<favor_reason></dd><dt>心声</dt><dd class=\"zyx-hud-value\">$<favor_mind></dd><dt>形貌</dt><dd class=\"zyx-hud-value\">$<favor_companion></dd></dl>\n        <details class=\"zyx-hud-subfold\"><summary>在场他人<span aria-hidden=\"true\"> ↗</span></summary><div class=\"zyx-hud-extra\"><article class=\"zyx-hud-extra-person\"><h4>$<e1_name></h4><div class=\"zyx-hud-extra-fields\"><span class=\"zyx-hud-extra-stage\">$<e1_stage></span><span class=\"zyx-hud-extra-aura\">$<e1_aura></span><p><em>心声</em><span class=\"zyx-hud-value\">$<e1_mind></span></p><p><em>形貌</em><span class=\"zyx-hud-value\">$<e1_demeanor></span></p></div></article><article class=\"zyx-hud-extra-person\"><h4>$<e2_name></h4><div class=\"zyx-hud-extra-fields\"><span class=\"zyx-hud-extra-stage\">$<e2_stage></span><span class=\"zyx-hud-extra-aura\">$<e2_aura></span><p><em>心声</em><span class=\"zyx-hud-value\">$<e2_mind></span></p><p><em>形貌</em><span class=\"zyx-hud-value\">$<e2_demeanor></span></p></div></article><p class=\"zyx-hud-extra-empty\">未记在场他人。</p></div></details>\n      </div>\n    </details>\n    <details class=\"zyx-hud-fold\">\n      <summary><span class=\"zyx-hud-index\">贰</span><span class=\"zyx-hud-title\">武学札记</span><span class=\"zyx-hud-summary zyx-hud-value\">$<growth_skill></span><span class=\"zyx-hud-chevron\" aria-hidden=\"true\">＋</span></summary>\n      <div class=\"zyx-hud-body\"><p class=\"zyx-hud-note\">只记此番所练所悟，非现有境界或功力总量。</p><dl><dt>所习</dt><dd class=\"zyx-hud-value\">$<growth_skill></dd><dt>契机</dt><dd class=\"zyx-hud-value\">$<growth_reason></dd><dt>分量</dt><dd><span class=\"zyx-hud-value\">$<growth_weight></span><small class=\"zyx-hud-key\">一为常悟，二为大悟；无则未记成长。</small></dd></dl></div>\n    </details>\n    <section class=\"zyx-hud-clue\"><h4>眼前线索</h4><p class=\"zyx-hud-value\">$<clue></p></section>\n    <div class=\"zyx-hud-rumors\"><section><h4>近处风闻</h4><p class=\"zyx-hud-value\">$<news_near></p></section><section><h4>远地传闻</h4><p class=\"zyx-hud-value\">$<news_mid></p></section></div>\n    <details class=\"zyx-hud-fold\">\n      <summary><span class=\"zyx-hud-index\">叁</span><span class=\"zyx-hud-title\">人物动向</span><span class=\"zyx-hud-summary\">处境 · 伤亡</span><span class=\"zyx-hud-chevron\" aria-hidden=\"true\">＋</span></summary>\n      <div class=\"zyx-hud-body\"><dl><dt>白雪莲</dt><dd class=\"zyx-hud-value\">$<bailian_state></dd><dt>薛霜灵</dt><dd class=\"zyx-hud-value\">$<shuangling_state></dd><dt>伤亡勘验</dt><dd class=\"zyx-hud-value\">$<roster_event></dd></dl><p class=\"zyx-hud-note\">依本轮已报之事存记，不据风闻判生死。</p></div>\n    </details>\n  </div>\n</div>\n",
    "trimStrings": [],
