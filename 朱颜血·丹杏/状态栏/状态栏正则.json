[
  {
    "id": "zyx-hud-ink-v1",
    "scriptName": "ZYX_02_状态栏HUD渲染",
    "findRegex": "<status_bar>\\s*(?:<time>(?<time>[^<]*)</time>\\s*)?(?:<elapsed>(?<elapsed>[^<]*)</elapsed>\\s*)?(?:<location>(?<location>[^<]*)</location>\\s*)?(?:<weather>(?<weather>[^<]*)</weather>\\s*)?(?:<environment>(?<environment>[^<]*)</environment>\\s*)?(?:<favor_char>(?<favor_char>[^<]*)</favor_char>\\s*)?(?:<favor_stage>(?<favor_stage>[^<]*)</favor_stage>\\s*)?(?:<favor_aura>(?<favor_aura>[^<]*)</favor_aura>\\s*)?(?:<favor_reason>(?<favor_reason>[^<]*)</favor_reason>\\s*)?(?:<favor_mind>(?<favor_mind>[^<]*)</favor_mind>\\s*)?(?:<favor_companion>(?<favor_companion>[^<]*)</favor_companion>\\s*)?(?:<extra_char_1>(?:\\s*<name>(?:无|暂无|无他人|暂无他人|独处)</name>\\s*(?:<stage>[^<]*</stage>\\s*)?(?:<aura>[^<]*</aura>\\s*)?(?:<mind>[^<]*</mind>\\s*)?(?:<demeanor>[^<]*</demeanor>\\s*)?|\\s*<name>(?<e1_name>[^<]*)</name>\\s*<stage>(?<e1_stage>[^<]*)</stage>\\s*<aura>(?<e1_aura>[^<]*)</aura>\\s*<mind>(?<e1_mind>[^<]*)</mind>\\s*<demeanor>(?<e1_demeanor>[^<]*)</demeanor>\\s*|[^<]*)</extra_char_1>\\s*)?(?:<extra_char_2>(?:\\s*<name>(?:无|暂无|无他人|暂无他人|独处)</name>\\s*(?:<stage>[^<]*</stage>\\s*)?(?:<aura>[^<]*</aura>\\s*)?(?:<mind>[^<]*</mind>\\s*)?(?:<demeanor>[^<]*</demeanor>\\s*)?|\\s*<name>(?<e2_name>[^<]*)</name>\\s*<stage>(?<e2_stage>[^<]*)</stage>\\s*<aura>(?<e2_aura>[^<]*)</aura>\\s*<mind>(?<e2_mind>[^<]*)</mind>\\s*<demeanor>(?<e2_demeanor>[^<]*)</demeanor>\\s*|[^<]*)</extra_char_2>\\s*)?(?:<growth_skill>(?<growth_skill>[^<]*)</growth_skill>\\s*)?(?:<growth_reason>(?<growth_reason>[^<]*)</growth_reason>\\s*)?(?:<growth_weight>(?<growth_weight>[^<]*)</growth_weight>\\s*)?(?:<roster_event>(?<roster_event>[^<]*)</roster_event>\\s*)?(?:<bailian_state>(?<bailian_state>[^<]*)</bailian_state>\\s*)?(?:<shuangling_state>(?<shuangling_state>[^<]*)</shuangling_state>\\s*)?(?:<clue>(?<clue>[^<]*)</clue>\\s*)?(?:<clue_obtained>(?<clue_obtained>[^<]*)</clue_obtained>\\s*)?(?:<news_near>(?<news_near>[^<]*)</news_near>\\s*)?(?:<news_mid>(?<news_mid>[^<]*)</news_mid>\\s*)?(?:<crisis>(?<crisis>[^<]*)</crisis>\\s*)?</status_bar>",
    "replaceString": "<style>\n/* gpt：保留截图布局，改为丹杏宣德案牍配色：墨黑、旧纸灰、暗铜、朱砂。 */\n.zyx-hud,.zyx-hud * {box-sizing:border-box;}\n.zyx-hud {position:relative;width:100%;max-width:1120px;margin:4px auto;padding:11px 14px;color:#dddcd0;background:linear-gradient(165deg,#151b1cfa,#0d1415fc);border:1px solid #ad987147;border-radius:5px;box-shadow:0 16px 44px #0009,inset 0 0 1px 1px #ad98711a;font:12.5px/1.55 -apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif;text-align:left;overflow-wrap:anywhere;}\n.zyx-hud .zyx-hud-value:empty::before {content:'未记';color:#94a394;}\n.zyx-hud .zyx-hud-head {display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;}\n.zyx-hud .zyx-hud-head strong {font-size:14px;color:#e5dac1;letter-spacing:.6px;}\n.zyx-hud .zyx-hud-head strong>span {color:#ad9871;}\n.zyx-hud .zyx-hud-chapter {font-size:11px;color:#ad9871;background:#ad987114;border:1px solid #ad987147;border-radius:4px;padding:2px 7px;letter-spacing:.3px;}\n.zyx-hud .zyx-hud-grid {display:flex;flex-direction:column;gap:6px;border-bottom:1px solid #ad987138;padding-bottom:10px;margin-bottom:10px;}\n.zyx-hud .zyx-hud-row {display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:6px;}\n.zyx-hud .zyx-hud-env-row {grid-template-columns:minmax(150px,.31fr) minmax(0,1fr);}\n.zyx-hud .zyx-hud-pill {display:flex;align-items:flex-start;gap:6px;min-width:0;padding:5px 9px;font-size:11.5px;line-height:1.4;border-radius:6px;border:1px solid #ad987147;background:#1a2220bf;}\n.zyx-hud .zyx-hud-pill>span:first-child {flex-shrink:0;}\n.zyx-hud .zyx-hud-time {color:#ddd0aa;border-color:#a7966d52;background:#a7966d14;}\n.zyx-hud .zyx-hud-place {color:#b8c8be;border-color:#8eaaa352;background:#8eaaa30f;}\n.zyx-hud .zyx-hud-weather {color:#c8b49a;border-color:#a77a5447;background:#a77a5412;}\n.zyx-hud .zyx-hud-senses {color:#b5c7b0;border-color:#86947a47;background:#86947a10;}\n.zyx-hud .zyx-hud-tools {display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:6px;align-items:start;}\n.zyx-hud .zyx-hud-elapsed {color:#c3c5ae;border-color:#91a49752;background:#91a49710;min-height:30px;}\n.zyx-hud summary {cursor:pointer;list-style:none;}\n.zyx-hud summary::-webkit-details-marker {display:none;}\n.zyx-hud summary:focus-visible {outline:2px solid #a7966d;outline-offset:3px;}\n.zyx-hud .zyx-hud-tool {position:relative;min-width:0;}\n.zyx-hud .zyx-hud-tool>summary {display:flex;align-items:center;gap:7px;padding:5px 9px;min-height:30px;border:1px solid #ad987166;border-radius:6px;color:#e8d9a0;background:#ad987114;font-size:11.5px;}\n.zyx-hud .zyx-hud-tool>summary:hover {border-color:#ad9871;}\n.zyx-hud .zyx-hud-drop {margin-left:auto;color:#a39261;}\n.zyx-hud .zyx-hud-tool-icon {font-weight:700;color:#ad9871;}\n.zyx-hud .zyx-hud-record>summary {color:#d4c39b;background:#7044371a;white-space:nowrap;}\n.zyx-hud .zyx-hud-popover {padding:12px;background:#121722;border:1px solid #ad987152;border-top:0;border-radius:0 0 6px 6px;}\n.zyx-hud .zyx-hud-record .zyx-hud-popover {position:absolute;right:0;top:100%;width:270px;max-width:calc(100vw - 48px);z-index:2;box-shadow:0 10px 26px #000b;}\n.zyx-hud h4 {margin:0 0 8px;font-size:12px;color:#ad9871;}\n.zyx-hud dl {display:grid;grid-template-columns:65px minmax(0,1fr);gap:7px 10px;margin:0;font-size:11px;}\n.zyx-hud dt {color:#c5af6b;}\n.zyx-hud dd {margin:0;color:#d0d6e0;}\n.zyx-hud small {display:block;font-size:10px;color:#94a394;margin-top:4px;}\n.zyx-hud .zyx-hud-trend {padding:9px 11px;border:1px solid #a9564547;border-left:4px solid #a95645;border-radius:4px;background:linear-gradient(100deg,#652d2724,#42221e1a);margin-bottom:10px;}\n.zyx-hud .zyx-hud-trend-head {display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin-bottom:5px;}\n.zyx-hud .zyx-hud-trend-head>b {padding:2px 7px;border:1px solid #a9564566;border-radius:4px;font-size:10.5px;color:#ddb8a5;background:#763b3033;}\n.zyx-hud .zyx-hud-trend-head>strong {font-size:12px;color:#eee3e5;}\n.zyx-hud .zyx-hud-trend p {margin:0;font-size:11.5px;color:#d5cbd0;line-height:1.6;}\n.zyx-hud .zyx-hud-companion {display:flex;align-items:stretch;gap:13px;padding:10px 12px;background:linear-gradient(145deg,#202726cc,#11191aeb);border:1px solid #ad98713d;border-radius:5px;box-shadow:0 4px 20px #0007;margin-bottom:10px;}\n.zyx-hud .zyx-hud-avatar {width:18%;min-width:120px;max-width:188px;min-height:250px;background:#141b1d;border:1.8px solid #ad987166;border-radius:4px;box-shadow:0 0 14px #0008;flex-shrink:0;}\n.zyx-hud .zyx-hud-companion-body {display:flex;flex-direction:column;gap:8px;min-width:0;flex:1;}\n.zyx-hud .zyx-hud-person {display:flex;align-items:center;flex-wrap:wrap;gap:6px;row-gap:5px;}\n.zyx-hud h3 {margin:0;font-size:15px;font-weight:700;color:#fff;letter-spacing:.5px;}\n.zyx-hud .zyx-hud-role-tag {font-size:10.5px;color:#ddd0aa;background:#ad987126;border:1px solid #ad987159;padding:1px 5px;border-radius:4px;}\n.zyx-hud .zyx-hud-stage {display:inline-flex;gap:3px;font-size:11.5px;font-weight:700;padding:3px 7px;border-radius:4px;letter-spacing:.4px;color:#ddd0aa;background:linear-gradient(135deg,#6e634559,#1e1b4b73);border:1px solid #a7966d8c;box-shadow:none;}\n.zyx-hud .zyx-hud-aura {font-size:11px;color:#a7bcad;background:#17231f99;border:1px solid #a7bcad40;padding:3px 7px;border-radius:4px;}\n.zyx-hud .zyx-hud-reason {margin:0;font-size:11.5px;color:#b8a888;line-height:1.5;}\n.zyx-hud .zyx-hud-reason b,.zyx-hud .zyx-hud-main b {color:#ad9871;font-weight:700;margin-right:5px;}\n.zyx-hud .zyx-hud-main {flex:1;display:flex;flex-direction:column;gap:8px;padding:10px 12px;background:linear-gradient(150deg,#242c29a6,#161f1ed9);border:1px solid #ad987129;border-radius:5px;}\n.zyx-hud .zyx-hud-mind {margin:0;padding:4px 8px;font-size:11.5px;line-height:1.55;background:#17231f8c;border-left:2.5px solid #ad9871;border-radius:0 4px 4px 0;}\n.zyx-hud .zyx-hud-demeanor {margin:0;padding:6px 10px;font-size:13px;line-height:1.7;color:#e0dbca;background:#17231f59;border-left:3px solid #ad9871;border-radius:0 4px 4px 0;}\n.zyx-hud .zyx-hud-subfold {font-size:10px;color:#94a394;}\n.zyx-hud .zyx-hud-subfold>summary {padding:1px 0;}\n.zyx-hud .zyx-hud-extra {padding:10px;background:#141b1d;border:1px solid #ad987133;border-radius:6px;margin-top:5px;}\n.zyx-hud .zyx-hud-extra-person {margin-bottom:10px;}\n.zyx-hud .zyx-hud-extra-person:has(>h4:empty) {display:none;}\n.zyx-hud .zyx-hud-extra:has(.zyx-hud-extra-person>h4:not(:empty)) .zyx-hud-extra-empty {display:none;}\n.zyx-hud .zyx-hud-extra-empty {margin:0;}\n.zyx-hud .zyx-hud-extra-fields {font-size:11px;color:#bfc5bc;}\n.zyx-hud .zyx-hud-extra-fields p {display:flex;gap:8px;margin:5px 0;}\n.zyx-hud .zyx-hud-extra-fields em {font-style:normal;color:#ad9871;flex:0 0 26px;}\n.zyx-hud .zyx-hud-extra-stage,.zyx-hud .zyx-hud-extra-aura {color:#bfdbfe;font-size:10px;margin-right:8px;}\n.zyx-hud .zyx-hud-clue {display:flex;align-items:baseline;gap:7px;padding:10px 11px;border:1px solid #ad987152;border-left:4px solid #ad9871;border-radius:5px;background:#ad987108;margin-bottom:9px;color:#f6e7b4;font-size:11.5px;}\n.zyx-hud .zyx-hud-clue>b {flex-shrink:0;color:#e6d9b9;}\n.zyx-hud .zyx-hud-clue p {margin:0;min-width:0;line-height:1.6;}\n.zyx-hud .zyx-hud-rumors {padding:9px 11px;border:1px solid #ad98713d;background:#111a1aa6;border-radius:5px;}\n.zyx-hud .zyx-hud-rumors>section {display:flex;align-items:baseline;gap:8px;padding:1px 0 7px;margin-bottom:6px;border-bottom:1px dashed #ad987126;}\n.zyx-hud .zyx-hud-rumors>section:last-child {margin:0;padding-bottom:1px;border-bottom:0;}\n.zyx-hud .zyx-hud-rumors h4 {flex:0 0 76px;margin:0;padding:2px 0;font-size:11px;line-height:1.25;text-align:center;border-radius:4px;color:#b8c8be;background:#46645e38;border:1px solid #8eaaa361;}\n.zyx-hud .zyx-hud-rumors>section:last-child h4 {color:#d4c39b;background:#6e634538;border-color:#a7966d61;}\n.zyx-hud .zyx-hud-rumors p {flex:1;min-width:0;margin:0;color:#bfc5bc;font-size:11.5px;line-height:1.55;}\n.zyx-hud .zyx-hud-note {font-size:11px;color:#94a394;}\n@media(max-width:650px) {\n .zyx-hud {padding:10px;}\n .zyx-hud .zyx-hud-chapter {font-size:9px;padding:2px 4px;}\n .zyx-hud .zyx-hud-head strong {font-size:12px;}\n .zyx-hud .zyx-hud-row {grid-template-columns:minmax(0,1fr);}\n .zyx-hud .zyx-hud-env-row {grid-template-columns:minmax(0,1fr);}\n .zyx-hud .zyx-hud-tools {grid-template-columns:minmax(0,1fr) auto;}\n .zyx-hud .zyx-hud-growth {grid-column:1 / -1;}\n .zyx-hud .zyx-hud-companion {padding:9px;gap:9px;flex-wrap:wrap;}\n .zyx-hud .zyx-hud-avatar {min-width:0;width:72px;min-height:98px;max-width:72px;}\n .zyx-hud .zyx-hud-companion-body {flex-basis:calc(100% - 90px);}\n .zyx-hud .zyx-hud-person {gap:5px;}\n .zyx-hud h3 {font-size:14px;}\n .zyx-hud .zyx-hud-stage,.zyx-hud .zyx-hud-aura {font-size:10px;padding:2px 5px;}\n .zyx-hud .zyx-hud-main {padding:8px;}\n .zyx-hud .zyx-hud-demeanor {font-size:12px;padding:5px 7px;}\n .zyx-hud .zyx-hud-clue {flex-wrap:wrap;gap:4px;font-size:11px;}\n .zyx-hud .zyx-hud-clue p {flex-basis:100%;}\n .zyx-hud .zyx-hud-rumors h4 {flex-basis:68px;font-size:10px;}\n}\n@media(prefers-reduced-motion:reduce) { .zyx-hud * {scroll-behavior:auto;} }\n\n/* 字形与装饰轻量收束；不增加纸纹、颗粒或金属高光。 */\n.zyx-hud .zyx-hud-head strong {font-family:ui-serif,'Songti SC',SimSun,serif;font-size:15px;letter-spacing:.1em;font-weight:600;}\n.zyx-hud .zyx-hud-head strong>span {color:#b29f7b;}\n.zyx-hud .zyx-hud-chapter {color:#c49379;border-color:#98574466;background:#68372c1a;border-radius:2px;}\n.zyx-hud h3 {font-family:ui-serif,'Songti SC',SimSun,serif;font-size:16px;color:#eee7d5;}\n.zyx-hud .zyx-hud-trend {border-left-width:3px;}\n.zyx-hud .zyx-hud-stage {border-color:#b0a07c66;background:linear-gradient(135deg,#72614330,#3d49402b);}\n.zyx-hud .zyx-hud-avatar {box-shadow:inset 0 0 18px #0003;border-color:#94876766;}\n\n</style>\n<div class=\"zyx-hud\" role=\"region\" aria-label=\"朱颜血丹杏态势仪\">\n  <header class=\"zyx-hud-head\"><strong>❖ 朱颜血·丹杏 <span>· 态势仪</span></strong><span class=\"zyx-hud-chapter\">【宣德 · 边陲风云】</span></header>\n  <div class=\"zyx-hud-grid\">\n    <div class=\"zyx-hud-row\"><div class=\"zyx-hud-pill zyx-hud-time\"><span aria-hidden=\"true\">时</span><span class=\"zyx-hud-value\">$<time></span></div><div class=\"zyx-hud-pill zyx-hud-place\"><span aria-hidden=\"true\">地</span><span class=\"zyx-hud-value\">$<location></span></div></div>\n    <div class=\"zyx-hud-row zyx-hud-env-row\"><div class=\"zyx-hud-pill zyx-hud-weather\"><span aria-hidden=\"true\">候</span><span class=\"zyx-hud-value\">$<weather></span></div><div class=\"zyx-hud-pill zyx-hud-senses\"><span aria-hidden=\"true\">境</span><span class=\"zyx-hud-value\">$<environment></span></div></div>\n    <div class=\"zyx-hud-tools\">\n      <details class=\"zyx-hud-tool zyx-hud-growth\"><summary><span class=\"zyx-hud-tool-icon\">武</span><span>本轮所悟 · <span class=\"zyx-hud-value\">$<growth_skill></span></span><span class=\"zyx-hud-drop\" aria-hidden=\"true\">⌄</span></summary><div class=\"zyx-hud-popover\"><h4>武学札记</h4><dl><dt>所练所悟</dt><dd class=\"zyx-hud-value\">$<growth_skill></dd><dt>领悟契机</dt><dd class=\"zyx-hud-value\">$<growth_reason></dd><dt>成长分量</dt><dd><span class=\"zyx-hud-value\">$<growth_weight></span><small>一为常悟，二为大悟；无则未记成长。</small></dd></dl></div></details>\n      <div class=\"zyx-hud-pill zyx-hud-elapsed\"><span aria-hidden=\"true\">时</span><span>历时 <span class=\"zyx-hud-value\">$<elapsed></span></span></div>\n      <details class=\"zyx-hud-tool zyx-hud-record\"><summary>▤ 案簿</summary><div class=\"zyx-hud-popover\"><h4>人物动向</h4><dl><dt>白雪莲</dt><dd class=\"zyx-hud-value\">$<bailian_state></dd><dt>薛霜灵</dt><dd class=\"zyx-hud-value\">$<shuangling_state></dd><dt>伤亡勘验</dt><dd class=\"zyx-hud-value\">$<roster_event></dd></dl></div></details>\n    </div>\n  </div>\n  <section class=\"zyx-hud-trend\"><div class=\"zyx-hud-trend-head\"><b>天下大势</b><strong>边陲暗流 · 本轮气象</strong></div><p class=\"zyx-hud-value\">$<crisis></p></section>\n  <section class=\"zyx-hud-companion\">\n    <div class=\"zyx-hud-avatar\" aria-hidden=\"true\"></div>\n    <div class=\"zyx-hud-companion-body\">\n      <div class=\"zyx-hud-person\"><h3 class=\"zyx-hud-value\">$<favor_char></h3><span class=\"zyx-hud-role-tag\">当前镜头</span><span class=\"zyx-hud-stage\">❖【<span class=\"zyx-hud-value\">$<favor_stage></span>】</span><span class=\"zyx-hud-aura\">◈ 心防气象 · <span class=\"zyx-hud-value\">$<favor_aura></span></span></div>\n      <p class=\"zyx-hud-reason\"><b>【心防因由】</b><span class=\"zyx-hud-value\">$<favor_reason></span></p>\n      <div class=\"zyx-hud-main\"><p class=\"zyx-hud-mind\"><b>【内心心声】</b><span class=\"zyx-hud-value\">$<favor_mind></span></p><p class=\"zyx-hud-demeanor\"><b>【形貌姿态】</b><span class=\"zyx-hud-value\">$<favor_companion></span></p></div>\n      <details class=\"zyx-hud-subfold\"><summary>在场他人<span aria-hidden=\"true\"> ↗</span></summary><div class=\"zyx-hud-extra\"><article class=\"zyx-hud-extra-person\"><h4>$<e1_name></h4><div class=\"zyx-hud-extra-fields\"><span class=\"zyx-hud-extra-stage\">$<e1_stage></span><span class=\"zyx-hud-extra-aura\">$<e1_aura></span><p><em>心声</em><span class=\"zyx-hud-value\">$<e1_mind></span></p><p><em>形貌</em><span class=\"zyx-hud-value\">$<e1_demeanor></span></p></div></article><article class=\"zyx-hud-extra-person\"><h4>$<e2_name></h4><div class=\"zyx-hud-extra-fields\"><span class=\"zyx-hud-extra-stage\">$<e2_stage></span><span class=\"zyx-hud-extra-aura\">$<e2_aura></span><p><em>心声</em><span class=\"zyx-hud-value\">$<e2_mind></span></p><p><em>形貌</em><span class=\"zyx-hud-value\">$<e2_demeanor></span></p></div></article><p class=\"zyx-hud-extra-empty\">未记在场他人。</p></div></details>\n    </div>\n  </section>\n  <section class=\"zyx-hud-clue\"><span aria-hidden=\"true\">察</span><b>【重要线索】</b><p class=\"zyx-hud-value\">$<clue></p></section>\n  <div class=\"zyx-hud-rumors\"><section><h4>【本地风闻】</h4><p class=\"zyx-hud-value\">$<news_near></p></section><section><h4>【远地风闻】</h4><p class=\"zyx-hud-value\">$<news_mid></p></section></div>\n</div>\n",
